{
  "manifold": "hemisphere",
  "n_train": 20000,
  "n_val": 1000,
  "batch_size": 256,
  "seed": 42,
  "val_distribution": "imbalanced",
  "schedule": {
    "sigma_min": 0.01,
    "sigma_max": 0.5
  },
  "score": {
    "x_dim": 3,
    "hidden_dim": 128,
    "n_layers": 3
  },
  "trainer": {
    "lr": 0.001,
    "weight_decay": 0.0,
    "epochs": 1000,
    "grad_clip": 1.0,
    "lr_schedule": "cosine",
    "eta_min": 1e-05,
    "patience": 300,
    "min_delta": 0.0001,
    "n_sigma_bins": 5
  },
  "run": {
    "out_dir": "results/toy_manifolds/score_model/hemisphere",
    "override": false
  }
}
